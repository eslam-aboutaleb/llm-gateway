# llm-gateway environment variable NAMES only
# Copy to .env and fill in actual values. NEVER commit .env

# ===========================================
# OCI Infrastructure (Terraform/Terramate)
# ===========================================
# OCI Tenancy OCID
OCI_TENANCY_OCID=
# OCI User OCID (for bootstrap only; CI uses OIDC)
OCI_USER_OCID=
# OCI Region (home region for Always Free)
OCI_REGION=
# OCI Compartment OCID
OCI_COMPARTMENT_OCID=
# SSH public key for VM access (OpenSSH format)
OCI_SSH_PUBLIC_KEY=
# DNS domain for gateway (e.g., llm.example.com)
GATEWAY_DNS_DOMAIN=

# ===========================================
# LiteLLM Proxy Configuration
# ===========================================
# LiteLLM master key (admin only, generate with: echo "sk-$(openssl rand -hex 32)")
LITELLM_MASTER_KEY=
# LiteLLM salt key for DB encryption (generate with: openssl rand -hex 32)
LITELLM_SALT_KEY=
# LiteLLM admin UI password (generate with: openssl rand -base64 24)
LITELLM_UI_PASSWORD=
# Database URL (PostgreSQL connection string)
DATABASE_URL=
# Redis password (generate with: openssl rand -hex 32)
REDIS_PASSWORD=
# Redis URL
REDIS_URL=

# ===========================================
# Upstream Provider Credentials
# ===========================================
# OpenAI API key (if using OpenAI models)
OPENAI_API_KEY=
# Anthropic API key (if using Anthropic models)
ANTHROPIC_API_KEY=
# Azure OpenAI (if using Azure)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
# Google Vertex AI (if using Vertex)
VERTEX_PROJECT=
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
# Amazon Bedrock (prefer OCI instance/workload identity over static keys)
AWS_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ROLE_NAME=
# Other providers as needed
# COHERE_API_KEY=
# MISTRAL_API_KEY=

# ===========================================
# Caddy / TLS
# ===========================================
# Email for ACME registration (Let's Encrypt)
ACME_EMAIL=

# ===========================================
# Monitoring / Alerting
# ===========================================
# Alert webhook URL (e.g., Slack, PagerDuty, email webhook)
ALERT_WEBHOOK_URL=
# OCI Monitoring compartment (if different)
OCI_MONITORING_COMPARTMENT=

# ===========================================
# Backup / Recovery
# ===========================================
# Age encryption public key for backups (generate with: age-keygen)
BACKUP_AGE_PUBLIC_KEY=
# OCI Object Storage namespace
OCI_OBJECT_STORAGE_NAMESPACE=
# Backup bucket name
OCI_BACKUP_BUCKET=

# ===========================================
# GitHub Actions / CI
# ===========================================
# GitHub repository for CI workflows (owner/repo)
GITHUB_REPOSITORY=
# OCI OIDC provider configuration
OCI_OIDC_PROVIDER_URL=